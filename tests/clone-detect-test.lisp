(in-package #:fs-backend-windows/tests)

;;; R4c-3 on Windows, on the default NTFS temp directory (C: on
;;; windows-latest): detection says :UNSUPPORTED-VOLUME, :auto copies, the
;;; helpers work on NTFS, and BLOCK-CLONE-FILE cleans up after itself.

(deftest-ntfs ntfs-helpers
  (with-work-dir (dir)
    (ok (null (volume-supports-block-clone-p dir)) "NTFS has no block refcounting")
    (let ((cluster (volume-cluster-size dir)))
      (ok (and (integerp cluster) (>= cluster 512) (= 1 (logcount cluster)))
          (format nil "a power-of-two cluster size: ~S" cluster)))
    (let ((guid (volume-guid-path dir)))
      (ok (and (stringp guid)
               (eql 0 (search "\\\\?\\Volume{" guid))
               (string= "}\\" guid :start2 (- (length guid) 2)))
          (format nil "a volume GUID path: ~S" guid)))))

(deftest-ntfs ntfs-volume-guid-spellings
  (with-work-dir (dir)
    (let* ((guid (volume-guid-path dir))
           (native-dir (native dir))
           (root (subseq native-dir 0 3))
           (sub-dir (ensure-directories-exist (sub dir "A Long Directory Name/inner/"))))
      (ok (string-equal guid (volume-guid-path root)) (format nil "the drive root ~A" root))
      (ok (string-equal guid (volume-guid-path (string-downcase root))) "a lower-case drive letter")
      (ok (string-equal guid (volume-guid-path sub-dir)) "a subdirectory")
      (ok (string-equal guid (volume-guid-path (short-path-name sub-dir))) "its 8.3 spelling")
      (ok (string-equal guid (volume-guid-path (native sub-dir))) "a native namestring"))))

(deftest-ntfs ntfs-detection
  (with-work-dir (dir)
    (ok (equal '(nil :unsupported-volume)
               (multiple-value-list (block-clone-available-p *fs* dir dir))))
    (ok (not (member :block-clone (sp:clone-mechanisms *fs* dir dir))))
    (ok (equal '(nil :unsupported-volume)
               (multiple-value-list (sp:fs-clone-supported-p *fs* dir)))
        "fs-clone-supported-p gives :block-clone's reason")
    (let ((memory (sp:make-memory-filesystem)))
      (ok (equal '(nil :unsupported-filesystem)
                 (multiple-value-list (block-clone-available-p memory #p"/" #p"/")))))))

(deftest-ntfs ntfs-auto-copies
  (with-work-dir (dir)
    (make-tree dir '("src/a.txt" "src/b/c.txt" "src/empty/"))
    (let ((report (sp:fs-clone-tree *fs* (sub dir "src/") (sub dir "dst/"))))
      (ok (eq :copy (sp:clone-report-mechanism report)))
      (ok (eq :unsupported-volume (sp:clone-report-reason report)))
      (ok (= 2 (sp:clone-report-copied report)))
      (ok (zerop (sp:clone-report-cloned report)))
      (ok (equal "src/b/c.txt" (uiop:read-file-string (sub dir "dst/b/c.txt")))))
    (ok (signals (sp:fs-clone-tree *fs* (sub dir "src/") (sub dir "dst2/") :mechanism :block-clone)
                 'sp:unsupported-operation)
        "by name on NTFS: unsupported-operation")
    (ok (not (probe-file (sub dir "dst2/"))) "nothing created")
    (ok (signals (sp:fs-clone-tree *fs* (sub dir "src/") (sub dir "dst3/") :mechanism :clone)
                 'sp:unsupported-operation))
    (let ((area (sp:fs-open-area *fs* (sub dir "src/"))))
      (unwind-protect
           (progn
             (ok (eq :copy (sp:area-mechanism area)) "an :auto area on NTFS is a copy area")
             (ok (eq :unsupported-volume (sp:clone-report-reason (sp:area-clone-report area)))))
        (sp:fs-close-area area)))))

(deftest-ntfs ntfs-block-clone-file
  (with-work-dir (dir)
    (let ((src (write-octets (sub dir "a.bin") (pseudo-random-octets 100000)))
          (dst (sub dir "b.bin")))
      (ok (equal '(nil :unsupported-volume) (clone-direct src dst))
          "the ioctl answers ERROR_INVALID_FUNCTION on NTFS")
      (ok (absent-p dst) "DESTINATION deleted"))
    (let ((dst (sub dir "missing-copy.bin")))
      (handler-case (progn (clone-direct (sub dir "missing.bin") dst)
                           (fail "a missing source must signal"))
        (block-clone-error (c)
          (ok (eql 2 (sp:clone-error-code c)) "ERROR_FILE_NOT_FOUND")
          (ok (equal "CreateFileW" (sp:clone-error-operation c)))
          (ok (eq :block-clone (sp:clone-error-mechanism c)))))
      (ok (absent-p dst)))
    (let ((src (write-octets (sub dir "c.bin") (pseudo-random-octets 5000)))
          (dst (write-octets (sub dir "d.bin") (pseudo-random-octets 10 9))))
      (handler-case (progn (clone-direct src dst) (fail "an existing destination must signal"))
        (block-clone-error (c)
          (ok (eql 80 (sp:clone-error-code c)) "ERROR_FILE_EXISTS (CREATE_NEW)")))
      (ok (equalp (pseudo-random-octets 10 9) (read-octets dst))
          "an existing DESTINATION is not ours: left as it was"))))

(deftest-ntfs ntfs-file-cluster-runs
  (with-work-dir (dir)
    (let* ((cluster (volume-cluster-size dir))
           (big (write-octets (sub dir "big.bin") (pseudo-random-octets (* 64 1024))))
           (runs (file-cluster-runs big)))
      (ok (consp runs) "a 64 KiB file has clusters")
      (ok (every (lambda (r) (and (= 3 (length r)) (every #'integerp r))) runs) "(vcn lcn count)")
      (ok (eql 0 (first (first runs))) "the first run starts at VCN 0")
      (ok (>= (* cluster (runs-clusters runs)) (* 64 1024)) "the runs cover the file")
      (ok (null (file-cluster-runs (write-octets (sub dir "empty.bin") (pseudo-random-octets 0))))
          "an empty file: no runs (ERROR_HANDLE_EOF)")
      (let ((copy (sub dir "copy.bin")))
        (sp:fs-clone-file *fs* big copy :mechanism :copy)
        (ok (disjoint-clusters-p big copy) "a copy has clusters of its own")))
    (ok (signals (file-cluster-runs (sub dir "missing.bin")) 'block-clone-error))))
